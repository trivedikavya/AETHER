---
---
<section id="stats" class="stats-section">
  <div class="container">
    <div class="stats-grid">
      <!-- Card 1 -->
      <div class="stat-card" data-speed="0.9">
        <span class="mono-accent stat-label">ENTRY 01 — FLIGHTS</span>
        <div class="stat-value-wrapper">
          <span class="stat-number" data-target="142" data-decimals="1">0.0</span><span class="stat-unit">M</span>
        </div>
        <p class="stat-desc font-mono">Autonomous missions successfully routed through urban coordinates.</p>
      </div>

      <!-- Card 2 -->
      <div class="stat-card" data-speed="1.15">
        <span class="mono-accent stat-label">ENTRY 02 — LOCK SPEED</span>
        <div class="stat-value-wrapper">
          <span class="stat-number" data-target="42" data-decimals="0">0</span><span class="stat-unit">MS</span>
        </div>
        <p class="stat-desc font-mono">Average 4D airspace recalculation and path conflict resolution speed.</p>
      </div>

      <!-- Card 3 -->
      <div class="stat-card" data-speed="0.95">
        <span class="mono-accent stat-label">ENTRY 03 — DOCKS</span>
        <div class="stat-value-wrapper">
          <span class="stat-number" data-target="320" data-decimals="0">0</span><span class="stat-unit">+</span>
        </div>
        <p class="stat-desc font-mono">Active ground docking terminals globally connected to the Aether grid.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-section {
    padding: 8rem 0;
    background-color: var(--paper-secondary);
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 2;
    transition: background-color 0.8s var(--ease-editorial),
                border-color 0.8s var(--ease-editorial);
  }

  @media (max-width: 768px) {
    .stats-section {
      padding: 4rem 0;
    }
  }

  .stats-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.2fr;
    gap: 2.5rem;
    position: relative;
    padding: 3rem 0;
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .stat-card {
    width: 100%;
    flex-shrink: 0;
    position: relative;
    background-color: var(--paper-secondary);
    padding: 2.5rem;
    border: 1px solid var(--line);
    border-radius: 4px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    transition: background-color 0.8s var(--ease-editorial), border-color 0.8s var(--ease-editorial);
  }

  /* Asymmetrical offsets & overlaps on Z-axis */
  .stat-card:nth-child(1) {
    margin-top: -3rem;
    z-index: 22;
  }
  .stat-card:nth-child(2) {
    margin-top: 4rem;
    z-index: 20;
  }
  .stat-card:nth-child(3) {
    margin-top: -1rem;
    z-index: 21;
  }

  @media (max-width: 900px) {
    .stat-card {
      width: 100%;
      margin-top: 0 !important;
      margin-left: 0 !important;
      z-index: 1 !important;
    }
  }

  .stat-label {
    margin-bottom: 1.5rem;
  }

  .stat-value-wrapper {
    display: flex;
    align-items: baseline;
    margin-bottom: 1rem;
  }

  .stat-number {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.15rem;
    font-weight: 500;
    line-height: 1;
    color: var(--ink);
    text-transform: uppercase;
    transition: color 0.8s var(--ease-editorial);
  }

  .stat-unit {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--accent-red);
    text-transform: uppercase;
    margin-left: 0.15rem;
  }

  .stat-desc {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.7rem;
    color: var(--ink-secondary);
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }
</style>

---
---

<section id="features" class="features-section">
  
  <!-- Feature Stage 1 -->
  <div class="feature-block" id="feature-1">
    <div class="container feature-container">
      <div class="feature-text">
        <span class="mono-accent stage-num">STAGE 01 — ROUTING CORRIDORS</span>
        <h2 class="feature-title">Airspace Partitioning & Spatial Corridors</h2>
        <p class="feature-desc">
          Aether dynamically divides regional airspace into high-precision vector corridors. Our predictive trajectory engine locks path coordinates, shifting travel corridors to bypass localized turbulence and drone congestion points in real-time.
        </p>
        <div class="feature-metadata font-mono">
          <div class="meta-row"><span>PROTOCOL:</span> <span>AE-ROUTING-V4</span></div>
          <div class="meta-row"><span>LOCK RATIO:</span> <span>99.42% STATUS ACTIVE</span></div>
        </div>
      </div>
      <div class="feature-visual">
        <div class="tech-panel">
          <div class="tech-panel-header">
            <span class="panel-dot"></span>
            <span class="panel-title">// ORBIT_MAP.SCHEMATIC</span>
          </div>
          <div class="panel-content">
            <!-- Grayscale high-contrast schematic layout -->
            <svg class="map-grid-svg" viewBox="0 0 400 240">
              <line x1="0" y1="40" x2="400" y2="40" stroke="rgba(20, 20, 20, 0.05)" stroke-width="1" />
              <line x1="0" y1="120" x2="400" y2="120" stroke="rgba(20, 20, 20, 0.05)" stroke-width="1" />
              <line x1="0" y1="200" x2="400" y2="200" stroke="rgba(20, 20, 20, 0.05)" stroke-width="1" />
              <line x1="80" y1="0" x2="80" y2="240" stroke="rgba(20, 20, 20, 0.05)" stroke-width="1" />
              <line x1="200" y1="0" x2="200" y2="240" stroke="rgba(20, 20, 20, 0.05)" stroke-width="1" />
              <line x1="320" y1="0" x2="320" y2="240" stroke="rgba(20, 20, 20, 0.05)" stroke-width="1" />
              
              <!-- Flight paths -->
              <path d="M40,180 Q160,30 260,140 T360,70" fill="none" stroke="rgba(20, 20, 20, 0.1)" stroke-width="1" stroke-dasharray="3 3" />
              <path d="M40,180 Q160,30 260,140 T360,70" fill="none" stroke="var(--ink)" stroke-width="1.5" />
              <circle cx="40" cy="180" r="3.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
              <circle cx="260" cy="140" r="3.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
              <circle cx="360" cy="70" r="3.5" fill="var(--paper)" stroke="var(--ink)" stroke-width="1.5" />
            </svg>
            <div class="visual-label font-mono">SYS_GRID_09 // OK</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <hr class="hairline-divider" />

  <!-- Feature Stage 2 -->
  <div class="feature-block block-right" id="feature-2-pin">
    <div class="container feature-container" id="feature-2-content">
      <div class="feature-visual">
        <div class="tech-panel">
          <div class="tech-panel-header">
            <span class="panel-dot warn"></span>
            <span class="panel-title">// LIDAR_RADAR.SHIELD</span>
          </div>
          <div class="panel-content flex-center">
            <!-- Grayscale/minimal visual shield schematic -->
            <div class="sensor-shield-visual">
              <div class="pulse-ring ring-1"></div>
              <div class="pulse-ring ring-2"></div>
              <div class="warning-symbol font-mono">ACTIVE SHIELD</div>
            </div>
            <div class="sensor-telem font-mono">
              <div>RANGE: <span>12.4M</span></div>
              <div>SWEEP RATE: <span>0.02S</span></div>
              <div>THREAT CORRELATION: <span>NIL</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="feature-text">
        <span class="mono-accent stage-num">STAGE 02 — LIDAR PROTECTION</span>
        <h2 class="feature-title">Precision Hover & Boundary Shield</h2>
        <p class="feature-desc">
          As the vehicle enters dense wind corridors, a virtual LIDAR shielding bubble initiates. Compressing spatial vectors at the edge boundaries allows the vehicle to sustain stable hovering offsets with a tolerance of under 2 millimeters.
        </p>
        <div class="feature-metadata font-mono">
          <div class="meta-row"><span>BOUNDS:</span> <span>2.0MM GYRO LOCKED</span></div>
          <div class="meta-row"><span>WIND SHEAR:</span> <span>COMPENSATING ACTIVE</span></div>
        </div>
      </div>
    </div>
  </div>

  <hr class="hairline-divider" />

  <!-- Feature Stage 3 -->
  <div class="feature-block" id="feature-3">
    <div class="container feature-container">
      <div class="feature-text">
        <span class="mono-accent stage-num">STAGE 03 — DOCKING DYNAMICS</span>
        <h2 class="feature-title">Optical Docking & Magnetic Clamp Align</h2>
        <p class="feature-desc">
          Optical computer vision sensors analyze ground docking clearances dynamically. Upon descent threshold confirmation, Aether synchronizes target locking positions to align clean touchdown onto electromagnetic terminal pads.
        </p>
        <div class="feature-metadata font-mono">
          <div class="meta-row"><span>DOCK:</span> <span>OPTICAL ALIGNED</span></div>
          <div class="meta-row"><span>CLAMPS:</span> <span>PRIMED STATUS READY</span></div>
        </div>
      </div>
      <div class="feature-visual">
        <div class="tech-panel">
          <div class="tech-panel-header">
            <span class="panel-dot success"></span>
            <span class="panel-title">// DOCK_ALIGN.GRID</span>
          </div>
          <div class="panel-content flex-center">
            <div class="landing-crosshairs">
              <div class="cross-line h"></div>
              <div class="cross-line v"></div>
              <div class="target-circle"></div>
              <div class="corner cr-tl"></div>
              <div class="corner cr-tr"></div>
              <div class="corner cr-bl"></div>
              <div class="corner cr-br"></div>
            </div>
            <div class="lock-status-label font-mono">GRID ACQUIRED</div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  .features-section {
    background-color: var(--paper);
    overflow: visible;
    transition: background-color 0.8s var(--ease-editorial);
  }

  .feature-block {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding: 8rem 0;
  }

  @media (max-width: 768px) {
    .feature-block {
      padding: 4rem 0;
    }
  }

  .feature-container {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 6rem;
    align-items: center;
    position: relative;
  }

  @media (max-width: 1024px) {
    .feature-container {
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .feature-container {
      grid-template-columns: 1fr;
      gap: 3.5rem;
    }
  }

  /* Alternating layouts */
  .block-right .feature-container {
    grid-template-columns: 1.1fr 1fr;
  }

  @media (max-width: 768px) {
    .block-right .feature-container {
      grid-template-columns: 1fr;
    }
    .block-right .feature-visual {
      order: 2;
    }
    .block-right .feature-text {
      order: 1;
    }
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .stage-num {
    color: var(--accent-red);
    margin-bottom: 1.5rem;
  }

  .feature-title {
    margin-bottom: 2rem;
  }

  .feature-desc {
    color: var(--ink-secondary);
    margin-bottom: 2.5rem;
    font-size: 1.0625rem;
  }

  .feature-metadata {
    width: 100%;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.65rem;
    color: var(--ink-tertiary);
  }

  .meta-row {
    display: flex;
    justify-content: space-between;
    letter-spacing: 0.08em;
  }

  .meta-row span:last-child {
    color: var(--ink);
  }

  /* Tech Schematic Visual Panels */
  .tech-panel {
    background-color: var(--paper-secondary);
    border: 1px solid var(--line);
    border-radius: 4px;
    width: 100%;
    aspect-ratio: 1.6 / 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: background-color 0.8s var(--ease-editorial),
                border-color 0.8s var(--ease-editorial);
  }

  .tech-panel-header {
    height: 38px;
    border-bottom: 1px solid var(--line);
    display: flex;
    align-items: center;
    padding: 0 1.25rem;
    gap: 0.5rem;
    transition: border-color 0.8s;
  }

  .panel-dot {
    width: 4px;
    height: 4px;
    background-color: var(--ink-tertiary);
    border-radius: 50%;
  }

  .panel-dot.warn { background-color: var(--accent-red); }
  .panel-dot.success { background-color: var(--ink); }

  .panel-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--ink-tertiary);
    letter-spacing: 0.08em;
  }

  .panel-content {
    flex: 1;
    position: relative;
    padding: 1.25rem;
    background-color: transparent;
    overflow: hidden;
  }

  .flex-center {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3rem;
  }

  @media (max-width: 480px) {
    .flex-center {
      flex-direction: column;
      gap: 1.5rem;
    }
  }

  .map-grid-svg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .visual-label {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    font-size: 0.6rem;
    color: var(--ink-tertiary);
    letter-spacing: 0.08em;
  }

  /* Sensor Shield Visual (Feature 2) */
  .sensor-shield-visual {
    position: relative;
    width: 100px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pulse-ring {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
  }

  .ring-1 {
    width: 80px;
    height: 80px;
    border: 1px dashed var(--accent-red);
    animation: pulseRing 3s cubic-bezier(0.16, 1, 0.3, 1) infinite;
  }

  .ring-2 {
    width: 100px;
    height: 100px;
    border: 1px solid rgba(194, 13, 38, 0.15);
    animation: pulseRing 3s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    animation-delay: 1.5s;
  }

  .warning-symbol {
    color: var(--accent-red);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.08em;
  }

  @keyframes pulseRing {
    0% { transform: scale(0.4); opacity: 0; }
    50% { opacity: 0.6; }
    100% { transform: scale(1.1); opacity: 0; }
  }

  .sensor-telem {
    font-size: 0.7rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--ink-tertiary);
  }

  .sensor-telem span {
    color: var(--ink);
  }

  /* Landing Crosshairs (Feature 3) */
  .landing-crosshairs {
    position: relative;
    width: 90px;
    height: 90px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cross-line {
    position: absolute;
    background-color: var(--line);
  }

  .cross-line.h { width: 100%; height: 1px; }
  .cross-line.v { width: 1px; height: 100%; }

  .target-circle {
    position: absolute;
    width: 50px;
    height: 50px;
    border: 1px solid var(--ink);
    border-radius: 50%;
    animation: targetScale 3s ease-in-out infinite alternate;
  }

  @keyframes targetScale {
    0% { transform: scale(0.9); opacity: 0.5; }
    100% { transform: scale(1.1); opacity: 1; }
  }

  .corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1px solid var(--ink);
  }

  .cr-tl { top: 0; left: 0; border-right: none; border-bottom: none; }
  .cr-tr { top: 0; right: 0; border-left: none; border-bottom: none; }
  .cr-bl { bottom: 0; left: 0; border-right: none; border-top: none; }
  .cr-br { bottom: 0; right: 0; border-left: none; border-top: none; }

  .lock-status-label {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--ink);
  }
</style>

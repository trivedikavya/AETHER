---
---
<nav id="navbar" class="nav-bar">
  <div class="nav-container container">
    <!-- Logo -->
    <a href="#" class="nav-logo">
      <span class="logo-text">AETHER</span>
      <span class="logo-dot"></span>
    </a>

    <!-- Nav Links (Center, Desktop only) -->
    <div class="nav-links">
      <a href="#features" class="nav-link-item mono-accent">01 — Logbook</a>
      <a href="#stats" class="nav-link-item mono-accent">02 — Metrics</a>
      <a href="#touchdown" class="nav-link-item mono-accent">03 — Landing</a>
    </div>

    <!-- Right Side CTA Link -->
    <div class="nav-cta">
      <a href="#touchdown" class="editorial-link nav-cta-link magnetic-btn" data-strength="12">
        Book Terminal Access <span>&rarr;</span>
      </a>
      
      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-btn" class="hamburger" aria-label="Toggle menu">
        <span class="line"></span>
        <span class="line"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-dropdown" class="mobile-menu">
    <div class="mobile-menu-links">
      <a href="#features" class="mobile-link">01 — Logbook</a>
      <a href="#stats" class="mobile-link">02 — Metrics</a>
      <a href="#touchdown" class="mobile-link">03 — Landing</a>
      <a href="#touchdown" class="editorial-link mobile-btn magnetic-btn">Book Terminal Access <span>&rarr;</span></a>
    </div>
  </div>
</nav>

<style>
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    border-bottom: 1px solid var(--line);
    background-color: var(--paper);
    transition: background-color 0.8s var(--ease-editorial),
                border-color 0.8s var(--ease-editorial);
  }

  .nav-container {
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  @media (max-width: 768px) {
    .nav-container {
      height: 64px;
    }
  }

  /* Logo */
  .nav-logo {
    display: flex;
    align-items: center;
    text-decoration: none;
    gap: 0.2rem;
    z-index: 1001;
  }

  .logo-text {
    font-family: 'Fraunces', serif;
    font-size: 1.35rem;
    font-weight: 400;
    color: var(--ink);
    letter-spacing: -0.02em;
  }

  .logo-dot {
    width: 4px;
    height: 4px;
    background-color: var(--accent-red);
    border-radius: 50%;
    display: inline-block;
  }

  /* Desktop Nav Links */
  .nav-links {
    display: flex;
    gap: 3rem;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }

  .nav-link-item {
    font-size: 0.65rem;
    text-decoration: none;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s;
  }

  .nav-link-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--accent-red);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-editorial);
  }

  .nav-link-item:hover {
    color: var(--accent-red);
  }

  .nav-link-item:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav-cta {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav-cta-link {
    padding: 0.25rem 0;
    font-size: 0.7rem;
  }

  @media (max-width: 768px) {
    .nav-cta-link {
      display: none;
    }
  }

  /* Hamburger Menu Button */
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 20px;
    height: 10px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  @media (max-width: 768px) {
    .hamburger {
      display: flex;
    }
  }

  .hamburger .line {
    width: 100%;
    height: 1px;
    background-color: var(--ink);
    transition: transform 0.3s var(--ease-editorial), background-color 0.8s;
  }

  .hamburger.open .line:first-child {
    transform: translateY(4.5px) rotate(45deg);
  }

  .hamburger.open .line:last-child {
    transform: translateY(-4.5px) rotate(-45deg);
  }

  /* Mobile Dropdown Menu */
  .mobile-menu {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: var(--paper);
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s var(--ease-editorial), visibility 0.4s;
  }

  .mobile-menu.open {
    opacity: 1;
    visibility: visible;
  }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
  }

  .mobile-link {
    font-family: 'Fraunces', serif;
    font-size: 2rem;
    font-weight: 400;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.4s var(--ease-editorial), transform 0.4s var(--ease-editorial);
  }

  .mobile-menu.open .mobile-link {
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-menu.open .mobile-link:nth-child(1) { transition-delay: 0.1s; }
  .mobile-menu.open .mobile-link:nth-child(2) { transition-delay: 0.15s; }
  .mobile-menu.open .mobile-link:nth-child(3) { transition-delay: 0.2s; }
  .mobile-menu.open .mobile-btn {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.25s;
  }

  .mobile-btn {
    opacity: 0;
    transform: translateY(20px);
    margin-top: 1.5rem;
    text-decoration: none;
  }
</style>

<script>
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileDropdown = document.getElementById('mobile-dropdown');

  if (mobileMenuBtn && mobileDropdown) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenuBtn.classList.toggle('open');
      mobileDropdown.classList.toggle('open');
      document.body.classList.toggle('lenis-stopped');
    });

    const links = mobileDropdown.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        mobileMenuBtn.classList.remove('open');
        mobileDropdown.classList.remove('open');
        document.body.classList.remove('lenis-stopped');
      });
    });
  }
</script>

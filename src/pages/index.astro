---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import LiveStatus from "../components/LiveStatus.astro";
import Features from "../components/Features.astro";
import Stats from "../components/Stats.astro";
import TouchdownCTA from "../components/TouchdownCTA.astro";
import Footer from "../components/Footer.astro";
import VehicleSVG from "../components/VehicleSVG.astro";
import "../styles/global.css";
---

<Layout 
  title="Aether — Autonomous Flight Tracking & Drone Delivery SaaS" 
  description="Experience decentralized logistics. Set custom coordinates, track automated drone descent, and experience precise touchdown lock onto docking electromagnetic terminals."
>
  <Navigation />
  <main>
    <Hero />
    <LiveStatus />
    <Features />
    <Stats />
    <TouchdownCTA />
  </main>
  
  <!-- Global Flight Path SVG Overlay (Drawn dynamically in main.js connecting visual grids) -->
  <svg id="global-flight-path-svg" class="global-flight-path-svg" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path id="global-flight-path-bg" stroke="rgba(194, 13, 38, 0.05)" stroke-width="1.5" stroke-dasharray="6 6" />
    <path id="global-flight-path-active" stroke="var(--accent-red)" stroke-width="2.2" stroke-linecap="round" />
  </svg>

  <!-- Global Drone Vehicle (Animated and positioned in main.js along section anchors) -->
  <div id="global-drone-container" class="global-drone-container">
    <div class="drone-rotator" id="global-drone-rotator">
      <VehicleSVG />
    </div>
    
    <!-- Floating drone telemetry panel -->
    <div class="drone-telemetry-tag" id="global-drone-telemetry">
      <div class="telemetry-line"><span class="label">NODE:</span> <span class="val font-mono">AE-992</span></div>
      <div class="telemetry-line"><span class="label">VEL:</span> <span class="val id-vel font-mono">72.4 M/S</span></div>
      <div class="telemetry-line"><span class="label">ALT:</span> <span class="val id-alt font-mono">1,402 M</span></div>
    </div>
  </div>

  <Footer />
</Layout>
